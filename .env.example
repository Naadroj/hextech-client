# MODÈLE — copier en `.env` (gitignored) et y mettre TA clé.
# Ne mets jamais de vraie clé dans CE fichier : il est suivi par git.
#
# Utilisé UNIQUEMENT par les scripts de benchmark (npm run harvest).
# Rien de tout ça n'est embarqué dans l'application.
#
# Clé de développeur : https://developer.riotgames.com/  (valable 24 h)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Plateforme (LEAGUE/SUMMONER) : euw1 | na1 | kr | eun1 | br1 | jp1 | oc1 | ...
RIOT_PLATFORM=euw1

# Région (MATCH-V5) : europe | americas | asia | sea
RIOT_REGION=europe

# ── Signalements (Supabase) ───────────────────────────────────────────────
# Ces deux valeurs sont inlinées DANS LE BUNDLE au `npm run build` (define).
# La clé publishable est publique par conception : la sécurité tient à la
# policy RLS « insert only ». Voir FEEDBACK.md.
HEXTECH_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
HEXTECH_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxx

# Clé `service_role` — NE JAMAIS l'embarquer dans l'app. Sert uniquement à
# `npm run feedback:review` depuis la machine du mainteneur.
SUPABASE_SERVICE_KEY=
