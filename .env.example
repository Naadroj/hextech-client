# MODÈLE — copier en `.env` (gitignored) et y mettre TA clé.
# Ne mets jamais de vraie clé dans CE fichier : il est suivi par git.
#
# Utilisé UNIQUEMENT par les scripts de benchmark (npm run harvest).
# Rien de tout ça n'est embarqué dans l'application.
#
# Clé de développeur : https://developer.riotgames.com/  (valable 24 h)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Plateforme (LEAGUE/SUMMONER) : euw1 | na1 | kr | eun1 | br1 | jp1 | oc1 | ...
RIOT_PLATFORM=euw1

# Région (MATCH-V5) : europe | americas | asia | sea
RIOT_REGION=europe
